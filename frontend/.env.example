# FRONTEND (Flask UI)

# CrewAI AMP deployment the UI talks to
CREWAI_ENTERPRISE_URL=
CREWAI_ENTERPRISE_TOKEN=

# Shared secret — AMP sends this as a Bearer token on every webhook call.
# Generate any random string; it just needs to be consistent here.
WEBHOOK_TOKEN=

# Public URL AMP calls back for webhook events (used in dev AND prod).
# In prod it falls back to the request URL, but setting it explicitly is recommended.
PUBLIC_BASE_URL=https://flight-concierge.ngrok.app

# DEV ONLY — in production Heroku injects PORT and NGROK_DOMAIN is unused.
NGROK_DOMAIN=flight-concierge.ngrok.app
PORT=5001
